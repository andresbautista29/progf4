# ---------------------------------------------------------------
# Excepciones personalizadas
# ---------------------------------------------------------------
class ErrorSoftwareFJ(Exception):
    """Error general del sistema, de aquí heredan los demás."""


class ClienteInvalidoError(ErrorSoftwareFJ):
    pass


class ServicioInvalidoError(ErrorSoftwareFJ):
    pass


class ServicioNoDisponibleError(ErrorSoftwareFJ):
    pass


class ReservaInvalidaError(ErrorSoftwareFJ):
    pass


class OperacionNoPermitidaError(ErrorSoftwareFJ):
    pass


class CalculoInconsistenteError(ErrorSoftwareFJ):
    pass


# ---------------------------------------------------------------
# Clase abstracta general
# ---------------------------------------------------------------
class Entidad(ABC):
    contador = 0  # para darle un id distinto a cada objeto

    def __init__(self):
        Entidad.contador += 1
        self._id = Entidad.contador

    def get_id(self):
        return self._id

    @abstractmethod
    def describir(self):
        pass

    def __str__(self):
        return self.describir()


# ---------------------------------------------------------------
# Cliente
# ---------------------------------------------------------------
class Cliente(Entidad):
    def __init__(self, nombre=None, documento=None, email=None, telefono=None):
        super().__init__()
        # atributos privados (encapsulación)
        self.__nombre = None
        self.__documento = None
        self.__email = None
        self.__telefono = None
        # se asignan con los setters para que se validen
        self.set_nombre(nombre)
        self.set_documento(documento)
        self.set_email(email)
        self.set_telefono(telefono)

    def get_nombre(self):
        return self.__nombre

    def get_documento(self):
        return self.__documento

    def get_email(self):
        return self.__email

    def get_telefono(self):
        return self.__telefono

    def set_nombre(self, nombre):
        if nombre is None or nombre.strip() == "":
            raise ClienteInvalidoError("Falta el nombre del cliente")
        if len(nombre.strip()) < 3 or any(c.isdigit() for c in nombre):
            raise ClienteInvalidoError(f"Nombre no válido: {nombre}")
        self.__nombre = nombre.strip()

    def set_documento(self, documento):
        if documento is None or str(documento).strip() == "":
            raise ClienteInvalidoError("Falta el documento del cliente")
        documento = str(documento).strip()
        if not documento.isdigit() or len(documento) < 6 or len(documento) > 12:
            raise ClienteInvalidoError(
                f"Documento no válido: {documento} (deben ser entre 6 y 12 números)")
        self.__documento = documento

    def set_email(self, email):
        # validación sencilla: debe tener @ y un punto después del @
        if email is None or "@" not in email or "." not in email.split("@")[-1]:
            raise ClienteInvalidoError(f"Correo no válido: {email}")
        self.__email = email.strip().lower()

    def set_telefono(self, telefono):
        if telefono is None or not str(telefono).isdigit() or len(str(telefono)) != 10:
            raise ClienteInvalidoError(
                f"Teléfono no válido: {telefono} (deben ser 10 números)")
        self.__telefono = str(telefono)

    def describir(self):
        return (f"Cliente {self._id}: {self.__nombre} | Doc: {self.__documento} | "
                f"{self.__email} | Tel: {self.__telefono}")
    

# ---------------------------------------------------------------
# Servicio (clase abstracta)
# ---------------------------------------------------------------
class Servicio(Entidad, ABC):
    IVA = 0.19

    def __init__(self, nombre, tarifa_hora):
        super().__init__()
        if nombre is None or str(nombre).strip() == "":
            raise ServicioInvalidoError("El servicio necesita un nombre")
        if not isinstance(tarifa_hora, (int, float)) or tarifa_hora <= 0:
            raise ServicioInvalidoError(f"Tarifa no válida: {tarifa_hora}")
        self._nombre = str(nombre).strip()
        self._tarifa_hora = tarifa_hora
        self._disponible = True

    def get_nombre(self):
        return self._nombre

    def esta_disponible(self):
        return self._disponible

    def set_disponible(self, valor):
        self._disponible = bool(valor)

    # Estos tres los sobrescribe cada servicio hijo (polimorfismo)
    @abstractmethod
    def calcular_costo(self, horas):
        pass

    @abstractmethod
    def validar_parametros(self, horas):
        pass

    # Python no tiene sobrecarga como Java, entonces se hace con
    # parámetros opcionales. Se puede llamar de varias formas:
    #   calcular_costo_total(3)
    #   calcular_costo_total(3, impuesto=0.19)
    #   calcular_costo_total(3, descuento=0.10)
    #   calcular_costo_total(3, 0.19, 0.10)
    def calcular_costo_total(self, horas, impuesto=None, descuento=0):
        self.validar_parametros(horas)

        if descuento < 0 or descuento >= 1:
            raise CalculoInconsistenteError(f"Descuento fuera de rango: {descuento}")
        if impuesto is not None and (impuesto < 0 or impuesto > 1):
            raise CalculoInconsistenteError(f"Impuesto fuera de rango: {impuesto}")

        total = self.calcular_costo(horas)
        total = total - total * descuento
        if impuesto:
            total = total + total * impuesto

        if total < 0:
            raise CalculoInconsistenteError("El costo dio negativo")
        return round(total, 2)
