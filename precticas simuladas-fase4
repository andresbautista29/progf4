# ---------------------------------------------------------------
# Excepciones personalizadas
# ---------------------------------------------------------------
class ErrorSoftwareFJ(Exception):
    """Error general del sistema, de aquí heredan los demás."""


class ClienteInvalidoError(ErrorSoftwareFJ):
    pass


class ServicioInvalidoError(ErrorSoftwareFJ):
    pass


class ServicioNoDisponibleError(ErrorSoftwareFJ):
    pass


class ReservaInvalidaError(ErrorSoftwareFJ):
    pass


class OperacionNoPermitidaError(ErrorSoftwareFJ):
    pass


class CalculoInconsistenteError(ErrorSoftwareFJ):
    pass


# ---------------------------------------------------------------
# Clase abstracta general
# ---------------------------------------------------------------
class Entidad(ABC):
    contador = 0  # para darle un id distinto a cada objeto

    def __init__(self):
        Entidad.contador += 1
        self._id = Entidad.contador

    def get_id(self):
        return self._id

    @abstractmethod
    def describir(self):
        pass

    def __str__(self):
        return self.describir()


# ---------------------------------------------------------------
# Cliente
# ---------------------------------------------------------------
class Cliente(Entidad):
    def __init__(self, nombre=None, documento=None, email=None, telefono=None):
        super().__init__()
        # atributos privados (encapsulación)
        self.__nombre = None
        self.__documento = None
        self.__email = None
        self.__telefono = None
        # se asignan con los setters para que se validen
        self.set_nombre(nombre)
        self.set_documento(documento)
        self.set_email(email)
        self.set_telefono(telefono)

    def get_nombre(self):
        return self.__nombre

    def get_documento(self):
        return self.__documento

    def get_email(self):
        return self.__email

    def get_telefono(self):
        return self.__telefono

    def set_nombre(self, nombre):
        if nombre is None or nombre.strip() == "":
            raise ClienteInvalidoError("Falta el nombre del cliente")
        if len(nombre.strip()) < 3 or any(c.isdigit() for c in nombre):
            raise ClienteInvalidoError(f"Nombre no válido: {nombre}")
        self.__nombre = nombre.strip()

    def set_documento(self, documento):
        if documento is None or str(documento).strip() == "":
            raise ClienteInvalidoError("Falta el documento del cliente")
        documento = str(documento).strip()
        if not documento.isdigit() or len(documento) < 6 or len(documento) > 12:
            raise ClienteInvalidoError(
                f"Documento no válido: {documento} (deben ser entre 6 y 12 números)")
        self.__documento = documento

    def set_email(self, email):
        # validación sencilla: debe tener @ y un punto después del @
        if email is None or "@" not in email or "." not in email.split("@")[-1]:
            raise ClienteInvalidoError(f"Correo no válido: {email}")
        self.__email = email.strip().lower()

    def set_telefono(self, telefono):
        if telefono is None or not str(telefono).isdigit() or len(str(telefono)) != 10:
            raise ClienteInvalidoError(
                f"Teléfono no válido: {telefono} (deben ser 10 números)")
        self.__telefono = str(telefono)

    def describir(self):
        return (f"Cliente {self._id}: {self.__nombre} | Doc: {self.__documento} | "
                f"{self.__email} | Tel: {self.__telefono}")
    

# ---------------------------------------------------------------
# Servicio (clase abstracta)
# ---------------------------------------------------------------
class Servicio(Entidad, ABC):
    IVA = 0.19

    def __init__(self, nombre, tarifa_hora):
        super().__init__()
        if nombre is None or str(nombre).strip() == "":
            raise ServicioInvalidoError("El servicio necesita un nombre")
        if not isinstance(tarifa_hora, (int, float)) or tarifa_hora <= 0:
            raise ServicioInvalidoError(f"Tarifa no válida: {tarifa_hora}")
        self._nombre = str(nombre).strip()
        self._tarifa_hora = tarifa_hora
        self._disponible = True

    def get_nombre(self):
        return self._nombre

    def esta_disponible(self):
        return self._disponible

    def set_disponible(self, valor):
        self._disponible = bool(valor)

    # Estos tres los sobrescribe cada servicio hijo (polimorfismo)
    @abstractmethod
    def calcular_costo(self, horas):
        pass

    @abstractmethod
    def validar_parametros(self, horas):
        pass

    # Python no tiene sobrecarga como Java, entonces se hace con
    # parámetros opcionales. Se puede llamar de varias formas:
    #   calcular_costo_total(3)
    #   calcular_costo_total(3, impuesto=0.19)
    #   calcular_costo_total(3, descuento=0.10)
    #   calcular_costo_total(3, 0.19, 0.10)
    def calcular_costo_total(self, horas, impuesto=None, descuento=0):
        self.validar_parametros(horas)

        if descuento < 0 or descuento >= 1:
            raise CalculoInconsistenteError(f"Descuento fuera de rango: {descuento}")
        if impuesto is not None and (impuesto < 0 or impuesto > 1):
            raise CalculoInconsistenteError(f"Impuesto fuera de rango: {impuesto}")

        total = self.calcular_costo(horas)
        total = total - total * descuento
        if impuesto:
            total = total + total * impuesto

        if total < 0:
            raise CalculoInconsistenteError("El costo dio negativo")
        return round(total, 2)


# ---------------------------------------------------------------
# Servicios especializados
# ---------------------------------------------------------------
class ReservaSala(Servicio):
    def __init__(self, nombre, tarifa_hora, capacidad):
        super().__init__(nombre, tarifa_hora)
        if not isinstance(capacidad, int) or capacidad <= 0:
            raise ServicioInvalidoError(f"Capacidad no válida: {capacidad}")
        self._capacidad = capacidad

    def validar_parametros(self, horas):
        if not isinstance(horas, (int, float)) or horas < 1 or horas > 8:
            raise ServicioInvalidoError(
                f"La sala '{self._nombre}' se reserva entre 1 y 8 horas (se pidió {horas})")

    def calcular_costo(self, horas):
        costo = self._tarifa_hora * horas
        if self._capacidad > 20:  # las salas grandes cuestan 10% más
            costo = costo * 1.10
        return costo

    def describir(self):
        return (f"[Sala] {self._nombre} | capacidad {self._capacidad} | "
                f"${self._tarifa_hora:,.0f} por hora")


class AlquilerEquipo(Servicio):
    DEPOSITO = 50000

    def __init__(self, nombre, tarifa_hora, tipo_equipo):
        super().__init__(nombre, tarifa_hora)
        if tipo_equipo is None or str(tipo_equipo).strip() == "":
            raise ServicioInvalidoError("Falta el tipo de equipo")
        self._tipo_equipo = tipo_equipo

    def validar_parametros(self, horas):
        if not isinstance(horas, (int, float)) or horas < 1 or horas > 72:
            raise ServicioInvalidoError(
                f"El equipo '{self._nombre}' se alquila entre 1 y 72 horas (se pidió {horas})")

    def calcular_costo(self, horas):
        return self._tarifa_hora * horas + self.DEPOSITO

    def describir(self):
        return (f"[Equipo] {self._nombre} ({self._tipo_equipo}) | "
                f"${self._tarifa_hora:,.0f} por hora + depósito de ${self.DEPOSITO:,.0f}")


class AsesoriaEspecializada(Servicio):
    # cuánto se multiplica la tarifa según el nivel del asesor
    NIVELES = {"junior": 1.0, "senior": 1.5, "experto": 2.0}

    def __init__(self, nombre, tarifa_hora, especialidad, nivel="junior"):
        super().__init__(nombre, tarifa_hora)
        if especialidad is None or str(especialidad).strip() == "":
            raise ServicioInvalidoError("Falta la especialidad")
        if nivel not in self.NIVELES:
            raise ServicioInvalidoError(f"Nivel no válido: {nivel}")
        self._especialidad = especialidad
        self._nivel = nivel

    def validar_parametros(self, horas):
        if not isinstance(horas, (int, float)) or horas < 0.5 or horas > 4:
            raise ServicioInvalidoError(
                f"La asesoría '{self._nombre}' dura entre 0.5 y 4 horas (se pidió {horas})")

    def calcular_costo(self, horas):
        return self._tarifa_hora * horas * self.NIVELES[self._nivel]

    def describir(self):
        return (f"[Asesoría] {self._nombre} | {self._especialidad} ({self._nivel}) | "
                f"${self._tarifa_hora:,.0f} por hora")


# ---------------------------------------------------------------
# Reserva
# ---------------------------------------------------------------
class Reserva(Entidad):
    def __init__(self, cliente, servicio, horas):
        super().__init__()
        if not isinstance(cliente, Cliente):
            raise ReservaInvalidaError("La reserva necesita un cliente válido")
        if not isinstance(servicio, Servicio):
            raise ReservaInvalidaError("La reserva necesita un servicio válido")
        if not servicio.esta_disponible():
            raise ServicioNoDisponibleError(
                f"El servicio '{servicio.get_nombre()}' no está disponible")

        # si los parámetros no sirven, lanzamos otra excepción pero dejamos
        # la original como causa (encadenamiento con "from")
        try:
            servicio.validar_parametros(horas)
        except ServicioInvalidoError as e:
            raise ReservaInvalidaError("No se pudo crear la reserva") from e

        self._cliente = cliente
        self._servicio = servicio
        self._horas = horas
        self._estado = "PENDIENTE"
        self._costo = None

    def get_estado(self):
        return self._estado

    def confirmar(self):
        if self._estado != "PENDIENTE":
            raise OperacionNoPermitidaError(
                f"Reserva {self._id}: no se puede confirmar, está {self._estado}")
        self._estado = "CONFIRMADA"
        logging.info(f"Reserva {self._id} confirmada")

    def cancelar(self):
        if self._estado == "CANCELADA" or self._estado == "PROCESADA":
            raise OperacionNoPermitidaError(
                f"Reserva {self._id}: no se puede cancelar, está {self._estado}")
        self._estado = "CANCELADA"
        logging.info(f"Reserva {self._id} cancelada")

    def procesar(self, impuesto=Servicio.IVA, descuento=0):
        try:
            if self._estado != "CONFIRMADA":
                raise OperacionNoPermitidaError(
                    f"Reserva {self._id}: debe estar CONFIRMADA para procesarse "
                    f"(está {self._estado})")
            total = self._servicio.calcular_costo_total(self._horas, impuesto, descuento)
        except CalculoInconsistenteError as e:
            raise ReservaInvalidaError(
                f"Reserva {self._id}: error calculando el costo") from e
        else:
            # esto solo se ejecuta si no hubo errores
            self._costo = total
            self._estado = "PROCESADA"
            logging.info(f"Reserva {self._id} procesada, total ${total:,.2f}")
            return total
        finally:
            # esto se ejecuta siempre
            logging.info(f"Terminó el intento de procesar la reserva {self._id}")

    def describir(self):
        if self._costo is not None:
            costo = f"${self._costo:,.2f}"
        else:
            costo = "sin calcular"
        return (f"Reserva {self._id} | {self._cliente.get_nombre()} -> "
                f"{self._servicio.get_nombre()} | {self._horas} h | "
                f"{self._estado} | {costo}")


    # ---------------------------------------------------------------
# Sistema: maneja las listas internas y atrapa los errores para que
# el programa nunca se caiga
# ---------------------------------------------------------------
class SistemaGestion:
    def __init__(self):
        self.clientes = []
        self.servicios = []
        self.reservas = []

    def registrar_cliente(self, **datos):
        try:
            cliente = Cliente(**datos)
            for c in self.clientes:
                if c.get_documento() == cliente.get_documento():
                    raise ClienteInvalidoError(
                        f"Ya hay un cliente con el documento {cliente.get_documento()}")
        except ClienteInvalidoError as e:
            logging.error(f"No se pudo registrar el cliente: {e}")
            print(f"   X Error de cliente: {e}")
            return None
        except TypeError as e:
            logging.error(f"Parámetros incorrectos al registrar cliente: {e}")
            print(f"   X Error de parámetros: {e}")
            return None
        else:
            self.clientes.append(cliente)
            logging.info(f"Cliente registrado: {cliente.get_nombre()}")
            print(f"   OK {cliente}")
            return cliente

    def crear_servicio(self, clase, *args):
        try:
            servicio = clase(*args)
        except (ServicioInvalidoError, TypeError) as e:
            logging.error(f"No se pudo crear el servicio {clase.__name__}: {e}")
            print(f"   X Error de servicio: {e}")
            return None
        else:
            self.servicios.append(servicio)
            logging.info(f"Servicio creado: {servicio.get_nombre()}")
            print(f"   OK {servicio}")
            return servicio

    def crear_reserva(self, cliente, servicio, horas, impuesto=Servicio.IVA, descuento=0):
        reserva = None
        try:
            reserva = Reserva(cliente, servicio, horas)
            self.reservas.append(reserva)
            reserva.confirmar()
            reserva.procesar(impuesto, descuento)
        except ErrorSoftwareFJ as e:
            causa = ""
            if e.__cause__ is not None:
                causa = f" (causa: {e.__cause__})"
            logging.error(f"Reserva fallida: {e}{causa}")
            print(f"   X Error de reserva: {e}{causa}")
        except Exception as e:
            # por si pasa algo que no esperábamos
            logging.error(f"Error inesperado: {e}")
            print(f"   X Error inesperado: {e}")
        else:
            print(f"   OK {reserva}")
        finally:
            logging.info("Terminó la operación de reserva")
        return reserva

    def mostrar_resumen(self):
        print("\n===== RESUMEN =====")
        print(f"Clientes: {len(self.clientes)} | Servicios: {len(self.servicios)} "
              f"| Reservas: {len(self.reservas)}")
        for r in self.reservas:
            print("  ", r)